{
  "name": "calcifer-harness-spike",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node src/spike.mjs && node src/offline-spike.mjs && node --test --experimental-test-isolation=none --test-concurrency=1 test/*.test.mjs",
    "test:offline": "node src/offline-spike.mjs && node --test --experimental-test-isolation=none --test-concurrency=1 test/selfhost*.test.mjs test/request-guard.test.mjs",
    "spike": "node src/spike.mjs",
    "test:collaboration": "node --test --test-concurrency=1 test/task-plan.test.mjs test/model-router.test.mjs test/collaboration-runner.test.mjs test/workspace-tools.test.mjs test/sandbox-check.test.mjs",
    "collaboration:plan": "node src/collaboration-cli.mjs",
    "collaboration:run": "node src/collaboration-run-cli.mjs",
    "goal:run": "node src/goal-cli.mjs",
    "test:goal": "node --test --test-concurrency=1 test/goal-request-gate.test.mjs test/goal-runner.test.mjs",
    "repo:check": "node src/collaboration-run-cli.mjs repo-check"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@opencode/cli": "2.1.4",
    "@opencode/plugin": "2.1.4",
    "@opencode/sdk": "2.1.4",
    "bun": "1.4.4"
  }
}
