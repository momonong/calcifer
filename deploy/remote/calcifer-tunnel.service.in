[Unit]
Description=Calcifer encrypted connection to configured HTTPS gateway
After=calcifer-remote.service network-online.target
BindsTo=calcifer-remote.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ControlMaster=no -o ControlPath=none -R 127.0.0.1:18470:127.0.0.1:18470 @GATEWAY_HOST@
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
