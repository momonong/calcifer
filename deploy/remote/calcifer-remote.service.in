[Unit]
Description=Calcifer private remote workbench
Wants=calcifer-tunnel.service

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@NODE@ @REPO@/bin/calcifer.mjs remote serve --config @CONFIG@
Environment=PATH=@PATH@
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
NoNewPrivileges=yes

[Install]
WantedBy=default.target
